# CleanSight Full Docker Setup Configuration

# ==========================================
# Frontend Configuration
# ==========================================
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here

# When running in browser, the browser needs to hit the backend exposed port, not the docker internal hostname
VITE_API_BASE_URL=http://localhost:5000
VITE_PROFILE_POLL_MS=0

# ==========================================
# Backend Configuration
# ==========================================
NODE_ENV=development
PORT=5000

# Docker internal MongoDB URI
MONGODB_URI=mongodb://mongodb:27017/cleansight

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_private_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

JWT_SECRET=cleansight-super-secret-key-change-in-production
CLIENT_URL=http://localhost:8080

# Internal Docker DNS resolution for ML service
ML_SERVICE_URL=http://ml:8000
CATEGORY_ML_SERVICE_URL=http://ml:8000
ML_SERVICE_TIMEOUT_MS=10000

# Notifications
NOTIFICATIONS_ENABLED=true
EMAIL_FROM="CleanSight Local <notifications@yourdomain.com>"
EMAIL_PROVIDER=

# Redis config for ML Queues and Rate Limiting
REDIS_URL=redis://redis:6379

TRUST_PROXY_HOPS=1

# ==========================================
# ML Service Configuration
# ==========================================
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000
BINARY_MODEL_PATH=models/trash_classifier.keras
BINARY_CLASS_NAMES_PATH=models/class_names.json
CATEGORY_MODEL_PATH=models/waste_category_classifier.pt
CATEGORY_CLASS_NAMES_PATH=models/category_class_names.json
BINARY_CONFIDENCE_THRESHOLD=0.85
CATEGORY_HIGH_CONFIDENCE_THRESHOLD=0.80
CATEGORY_MODERATE_CONFIDENCE_THRESHOLD=0.50
CATEGORY_LOW_CONFIDENCE_THRESHOLD=0.30
MAX_IMAGE_BYTES=5242880
PREDICTION_TIMEOUT_MS=5000
LOG_LEVEL=INFO
