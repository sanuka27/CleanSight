# Environment Variables
NODE_ENV=development
PORT=5000

# MongoDB Connection
# For local development, use: mongodb://localhost:27017/cleansight
# For MongoDB Atlas, use your connection string from: https://cloud.mongodb.com
MONGODB_URI=mongodb://localhost:27017/cleansight

# Firebase Admin SDK Configuration
# Get these from Firebase Console > Project Settings > Service Accounts
# Generate a new private key and use the values here
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_private_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# JWT Secret (Change this in production!)
JWT_SECRET=cleansight-super-secret-key-change-in-production

# Client URL (for CORS) - must match the Vite dev server port
CLIENT_URL=http://localhost:8080

# ML Service Configuration
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=10000
