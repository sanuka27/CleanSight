# Environment Variables
NODE_ENV=development
PORT=5000

# MongoDB Connection
# For local development, use: mongodb://localhost:27017/cleansight
# For MongoDB Atlas, use your connection string from: https://cloud.mongodb.com
MONGODB_URI=mongodb://localhost:27017/cleansight

# Firebase Admin SDK Configuration
# Get these from Firebase Console > Project Settings > Service Accounts
# Generate a new private key and use the values here
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_private_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# JWT Secret (Change this in production!)
JWT_SECRET=cleansight-super-secret-key-change-in-production

# Client URL (for CORS) - must match the Vite dev server port
CLIENT_URL=http://localhost:8080

# ML Service Configuration
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=10000

# ─── Notifications ───────────────────────────────────────────────────────────
# Master kill-switch (set to false to disable all notifications)
NOTIFICATIONS_ENABLED=true

# Sender address that appears in notification emails
EMAIL_FROM=CleanSight <notifications@yourdomain.com>

# Email provider: "resend" | "nodemailer" | leave blank to disable email
EMAIL_PROVIDER=

# ── Option A: Resend (recommended — free tier 100 emails/day) ────────────────
# Sign up at https://resend.com → API Keys → Create API Key
# Must verify a domain or use their sandbox address: onboarding@resend.dev
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx

# ── Option B: Nodemailer (any SMTP server) ───────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your-gmail-app-password

