# Environment Variables
NODE_ENV=development
PORT=5000

# MongoDB Connection
# For local development, use: mongodb://localhost:27017/cleansight
# For MongoDB Atlas, use your connection string from: https://cloud.mongodb.com
MONGODB_URI=mongodb://localhost:27017/cleansight

# Firebase Admin SDK Configuration
# Get these from Firebase Console > Project Settings > Service Accounts
# Generate a new private key and use the values here
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_private_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# JWT Secret (Change this in production!)
JWT_SECRET=cleansight-super-secret-key-change-in-production

# Client URL (for CORS and email links)
# Local dev:  http://localhost:8080
# Production: https://your-app.vercel.app
CLIENT_URL=https://clean-sight-frontend.vercel.app

# ML Service Configuration
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=10000

# ─── Notifications ───────────────────────────────────────────────────────────
# Master kill-switch (set to false to disable all notifications)
NOTIFICATIONS_ENABLED=true

# Sender address that appears in notification emails
EMAIL_FROM=CleanSight <notifications@yourdomain.com>

# Email provider: "resend" | "nodemailer" | leave blank to disable email
EMAIL_PROVIDER=

# ── Option A: Resend (recommended — free tier 100 emails/day) ────────────────
# Sign up at https://resend.com → API Keys → Create API Key
# Must verify a domain or use their sandbox address: onboarding@resend.dev
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx

# ── Option B: Nodemailer (any SMTP server) ───────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your-gmail-app-password

# ─── Redis (ML job queue & Rate Limiting) ────────────────────────────────────
# Required to enable the BullMQ ML inference queue (ARCH-008) and to share
# rate-limit counters across multiple workers.
# Without this, ML analysis and rate-limiting fall back to in-memory/stopgaps.
# Local dev: run `docker compose up -d redis` (see backend/docker-compose.yml)
# Production: use a managed Redis (Upstash, Redis Cloud, etc.)
#
# Option A — Connection URL (preferred)
REDIS_URL=redis://localhost:6379
#
# Option B — Individual fields (alternative)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false    # set to true for TLS (e.g. Upstash)

# ─── Security Headers ────────────────────────────────────────────────────────
# Number of reverse-proxy hops in front of the Node process.
# Set to 1 when behind a single Nginx/load-balancer; 0 to disable.
# Required for express-rate-limit to key on the real client IP.
TRUST_PROXY_HOPS=1

# (Production only) Endpoint that receives Content-Security-Policy violation
# reports.  Services like https://report-uri.com or a self-hosted endpoint work.
# Leave blank to disable CSP reporting.
CSP_REPORT_URI=

