{
  "name": "cleansight-backend",
  "version": "1.0.0",
  "description": "CleanSight Backend API - Express.js + MongoDB",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "build": "node -e \"console.log('cleansight-backend: no build step required')\"",
    "test": "node --test src/tests/roleGuard.test.js src/tests/reportStatus.test.js src/tests/badgeService.test.js src/tests/volunteerProgress.test.js",
    "test:unit": "node --test src/tests/roleGuard.test.js src/tests/reportStatus.test.js src/tests/badgeService.test.js src/tests/volunteerProgress.test.js src/tests/reportStatus.constants.test.js src/tests/analyticsService.unit.test.js",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js src/tests/auth.routes.test.js src/tests/reports.routes.test.js --testEnvironment node",
    "test:all": "pnpm test:unit && pnpm test:integration"
  },
  "dependencies": {
    "@sentry/node": "^10.67.0",
    "@sentry/profiling-node": "^10.67.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.79.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.6.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "rate-limit-redis": "^5.0.0",
    "resend": "^6.17.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "moduleNameMapper": {},
    "testMatch": [
      "**/tests/*.routes.test.js"
    ]
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2"
  }
}
