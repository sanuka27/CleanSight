# Firebase Configuration
# Get these values from your Firebase project settings:
# https://console.firebase.google.com/project/YOUR_PROJECT/settings/general
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# FCM Web Push VAPID Key
# Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Generate key pair
# Copy the "Key pair" value (not the Key ID)
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here

# API Configuration
# Backend service URL (default: http://localhost:5000)
VITE_API_BASE_URL=http://localhost:5000

# Auth profile polling interval in milliseconds (set to 0 to disable)
VITE_PROFILE_POLL_MS=0

# ─── Observability & Error Tracking ──────────────────────────────────────────
# Sentry DSN for frontend error tracking, session replay and performance.
# Get this from: https://sentry.io → Your Project → Settings → Client Keys (DSN)
# Leave blank to disable Sentry (the app will run normally without it).
VITE_SENTRY_DSN=

# Fraction of page loads to trace for performance monitoring (0.0 – 1.0).
# 0.1 = 10% in production, 1.0 = 100% in development.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional app version/release tag (should match Backend APP_VERSION for tracing).
VITE_APP_VERSION=
