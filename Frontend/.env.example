# Firebase Configuration
# Get these values from your Firebase project settings:
# https://console.firebase.google.com/project/YOUR_PROJECT/settings/general
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# API Configuration
# Backend service URL (default: http://localhost:5000)
VITE_API_BASE_URL=http://localhost:5000

# Auth profile polling interval in milliseconds (set to 0 to disable)
VITE_PROFILE_POLL_MS=0
