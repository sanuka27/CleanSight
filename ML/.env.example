# CleanSight ML Service Configuration

# Service Configuration
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000

# Model Paths (relative to ML/ directory)
# Phase 1: Binary classifier (trash vs non-trash)
BINARY_MODEL_PATH=models/trash_classifier.keras

# Phase 2: Category classifier (plastic, paper, glass, mixed)
CATEGORY_MODEL_PATH=models/waste_category_classifier.pt

# Confidence Thresholds
# Binary classifier confidence threshold for auto-acceptance
BINARY_CONFIDENCE_THRESHOLD=0.85

# Category classifier confidence threshold for auto-acceptance
CATEGORY_CONFIDENCE_THRESHOLD=0.85

# Service Timeouts (milliseconds)
# Maximum time for image processing
PREDICTION_TIMEOUT_MS=5000

# Logging
LOG_LEVEL=INFO
