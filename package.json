{
  "name": "cleansight-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "CleanSight - Community Waste Reporting & Cleanup Coordination Platform",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:frontend": "pnpm --filter cleansight-frontend dev",
    "dev:backend": "pnpm --filter cleansight-backend dev",
    "build": "pnpm --filter cleansight-frontend build",
    "install:all": "pnpm install",
    "test": "pnpm --filter cleansight-frontend test"
  },
  "keywords": ["mern", "waste-management", "community", "cleanup"],
  "author": "Sanuka",
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@swc/core",
      "esbuild",
      "msgpackr-extract",
      "protobufjs"
    ]
  }
}

